{
  "name": "nestjs-gcp-pubsub",
  "version": "0.4.0",
  "description": "NestJS microservice transport for GCP PubSub",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "lint": "tsc --noemit && biome check src __tests__",
    "lint:fix": "tsc --noemit && biome check --write src __tests__",
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.build.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamolegga/nestjs-gcp-pubsub.git"
  },
  "keywords": [
    "nest",
    "nestjs",
    "gcp",
    "pubsub",
    "transport",
    "microservice"
  ],
  "author": "iamolegga <iamolegga@gmail.com> (http://github.com/iamolegga)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/iamolegga/nestjs-gcp-pubsub/issues"
  },
  "homepage": "https://github.com/iamolegga/nestjs-gcp-pubsub#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@google-cloud/pubsub": "^6.0.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/microservices": "^12.0.1",
    "@swc/core": "^1.16.1",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.0.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "typescript": "^7.0.2",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@google-cloud/pubsub": "^3.0.3 || ^4.0.0 || ^5.0.0 || ^6.0.0",
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/microservices": "^11.0.0 || ^12.0.0"
  }
}
